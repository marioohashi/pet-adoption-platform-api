generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin
}

enum Species {
  cat
  dog
  other
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  role      UserRole  @default(user)
  phone     String?
  avatar    String?
  bio       String?
  city      String?
  state     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  animals   Animal[]
}

model Animal {
  id          String   @id @default(uuid())
  name        String
  species     String
  breed       String?
  age         Int?     // Total em meses
  size        String?
  sex         String?
  description String?
  photos      String[] @default([]) // 🟢 Array de fotos (Base64 ou URLs)
  photo       String?  @db.Text     // Mantido como foto principal/capa
  status      String   @default("available")
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}